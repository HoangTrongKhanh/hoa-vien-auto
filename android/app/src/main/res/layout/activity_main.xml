<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Trạng thái -->
        <TextView
            android:id="@+id/botStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:padding="12dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/reopenOverlay"
            style="@style/StepButton"
            android:layout_marginTop="8dp"
            android:text="Hiện bảng nổi"
            android:visibility="gone" />

        <!-- Bắt đầu -->
        <TextView
            style="@style/Header"
            android:text="Bắt đầu" />

        <TextView
            android:id="@+id/step1"
            style="@style/Step"
            android:text="1. Bật Trợ năng cho Hoa Viên Auto" />

        <TextView
            android:id="@+id/step1Hint"
            style="@style/Hint"
            android:text="Cài đặt → Hỗ trợ → Ứng dụng đã cài đặt → Hoa Viên Auto → bật, rồi bấm Cho phép." />

        <Button
            android:id="@+id/openA11y"
            style="@style/StepButton"
            android:text="Mở cài đặt Trợ năng" />

        <TextView
            android:id="@+id/restrictedHint"
            style="@style/Hint"
            android:text="Nếu máy báo &quot;Ứng dụng đã bị từ chối cấp quyền&quot; (hoặc ghi &quot;Do chế độ Cài đặt hạn chế kiểm soát&quot;): bấm Đóng → bấm nút dưới → ⋮ ở góc trên phải → Cho phép cài đặt bị hạn chế → xác nhận bằng vân tay/mã PIN → quay lại bật Trợ năng.\nNút ⋮ chỉ hiện sau khi bạn đã thử bật Trợ năng và bị báo như trên." />

        <Button
            android:id="@+id/openAppInfo"
            style="@style/StepButton"
            android:text="Mở thông tin ứng dụng" />

        <TextView
            android:id="@+id/step2"
            style="@style/Step"
            android:text="2. Cho phép thông báo (để bot báo khi cần bạn)" />

        <Button
            android:id="@+id/allowNotify"
            style="@style/StepButton"
            android:text="Cho phép thông báo" />

        <TextView
            android:id="@+id/step3"
            style="@style/Step"
            android:text="3. Mở game, vào Đấu hội → bảng Nhiệm Vụ" />

        <Button
            android:id="@+id/openGame"
            style="@style/StepButton"
            android:text="Mở game" />

        <TextView
            style="@style/Step"
            android:text="4. Bấm ▶ Chạy trên bảng nổi ở mép trên màn hình" />

        <TextView
            style="@style/Hint"
            android:text="• ▶ Chạy: quét cả danh sách, xóa nhiệm vụ điểm thấp, lặp lại theo chu kỳ.\n• Thử 1 lượt: chỉ báo những nhiệm vụ sẽ xóa, không xóa thật.\n• ■: dừng.  ≡: kéo để dời bảng nổi, chạm để thu gọn.\n• ✕: đóng bảng nổi (dừng bot nếu đang chạy). Mở lại bằng nút Hiện bảng nổi ở đầu màn hình này." />

        <!-- Cài đặt -->
        <TextView
            style="@style/Header"
            android:text="Cài đặt" />

        <LinearLayout style="@style/Row">

            <TextView
                style="@style/Label"
                android:text="Xóa nhiệm vụ có điểm ≤" />

            <EditText
                android:id="@+id/maxPoints"
                style="@style/Number" />
        </LinearLayout>

        <LinearLayout style="@style/Row">

            <TextView
                style="@style/Label"
                android:text="Quét lại sau (phút)" />

            <EditText
                android:id="@+id/intervalMin"
                style="@style/Number" />
        </LinearLayout>

        <LinearLayout style="@style/Row">

            <TextView
                style="@style/Label"
                android:text="Xóa tối đa mỗi lượt (0 = không giới hạn)" />

            <EditText
                android:id="@+id/maxDeletes"
                style="@style/Number" />
        </LinearLayout>

        <!-- Lưu ý -->
        <TextView
            style="@style/Header"
            android:text="Lưu ý" />

        <TextView
            style="@style/Hint"
            android:text="• Cắm sạc khi để bot chạy lâu. Bảng nổi giữ màn hình luôn sáng.\n• Để game ở bảng Nhiệm Vụ. Bot không tự mở lại game; khi bị thoát, bot gửi thông báo và tự chạy tiếp khi bạn mở lại bảng Nhiệm Vụ.\n• Đừng che cạnh trên của máy: tính năng Chống chạm nhầm của Samsung sẽ làm tối màn hình và chặn thao tác.\n• Bot tự mở khóa màn hình của Game Booster.\n• Tự động hóa có thể vi phạm điều khoản của game; bạn tự chịu trách nhiệm khi dùng.\n• App không đọc nội dung ứng dụng khác và không gửi dữ liệu ra ngoài." />

        <!-- Nhật ký -->
        <TextView
            style="@style/Header"
            android:text="Nhật ký" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/copyLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sao chép nhật ký" />

            <Button
                android:id="@+id/clearLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xóa nhật ký" />
        </LinearLayout>

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <!-- Nâng cao -->
        <Button
            android:id="@+id/toggleAdvanced"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nâng cao ▾" />

        <LinearLayout
            android:id="@+id/advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/showProbes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hiện các bài thử trên bảng nổi (nút ⋯)" />

            <CheckBox
                android:id="@+id/saveImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lưu ảnh đánh dấu để tra lỗi" />

            <TextView
                android:id="@+id/filesDir"
                style="@style/Hint"
                android:textIsSelectable="true" />

            <TextView
                style="@style/Hint"
                android:layout_marginTop="12dp"
                android:text="Bài thử Kéo: quãng kéo tính theo px của máy gốc rộng 1080, máy khác tự quy đổi. Bot dùng kéo 548px, 500 ms, giữ 150 ms (danh sách cuộn ~520px)." />

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/Label"
                    android:text="Quãng kéo (px)" />

                <EditText
                    android:id="@+id/dragDistance"
                    style="@style/Number" />
            </LinearLayout>

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/Label"
                    android:text="Thời gian kéo (ms)" />

                <EditText
                    android:id="@+id/dragMs"
                    style="@style/Number" />
            </LinearLayout>

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/Label"
                    android:text="Giữ trước khi nhả (ms)" />

                <EditText
                    android:id="@+id/holdMs"
                    style="@style/Number" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            style="@style/Hint"
            android:layout_marginTop="16dp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
